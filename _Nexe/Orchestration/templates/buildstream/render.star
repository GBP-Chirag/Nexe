# Starlark configuration and macro layer for BuildStream elements.
# This program has no file, process, clock, network, or environment access.
# The Nexe host validates the emitted paths and writes the static YAML files.

def _yaml_string(value):
    return "'" + value.replace("'", "''") + "'"

def manual_element(name, source_path, build_commands, install_commands):
    return {
        "filename": name + ".bst",
        "description": "Generated by the deterministic Nexe Starlark template",
        "source": source_path,
        "build": build_commands,
        "install": install_commands,
    }

def _emit_commands(key, commands):
    print("  " + key + ":")
    for command in commands:
        print("  - " + _yaml_string(command))

def emit(element):
    print("@@NEXE_BST " + element["filename"])
    print("kind: manual")
    print("description: " + _yaml_string(element["description"]))
    print("sources:")
    print("- kind: local")
    print("  path: " + _yaml_string(element["source"]))
    print("config:")
    _emit_commands("build-commands", element["build"])
    _emit_commands("install-commands", element["install"])

ELEMENTS = [
    manual_element(
        name = "hello",
        source_path = "source",
        build_commands = ["cc hello.c -o hello"],
        install_commands = ["install -D hello '%{install-root}/usr/bin/hello'"],
    ),
]

for element in ELEMENTS:
    emit(element)
