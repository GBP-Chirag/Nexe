# Nexe's default build language. Run: nexe build BUILD.sbl
# The toolchain name stays constant when its compiler changes per platform.
toolchain host_c {
    flavor = "gnu"
    cc = "cc"
    cxx = "c++"
    cflags = []
    cxxflags = ["-std=c++17"]
    ldflags = []
}

cc_binary hello {
    toolchain "host_c"
    source "hello.c"
    target "hello"
}
