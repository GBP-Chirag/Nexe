# Hide TypeScript from GitHub language stats
*.ts linguist-detectable=false
*.tsx linguist-detectable=false

# Exclude Makefiles from the language stats bar
Makefile -linguist-detectable
*.mk -linguist-detectable

# If your build folder or binary objects are accidentally tracked, exclude them too:
build/** linguist-vendored

# Hide CMakeLists.txt and all .cmake files from the language bar
CMakeLists.txt linguist-detectable=false
*.cmake linguist-detectable=false
*.cmake.in linguist-detectable=false

