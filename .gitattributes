# Hide TypeScript from GitHub language stats
*.ts linguist-detectable=false
*.tsx linguist-detectable=false

# Exclude Makefiles from the language stats bar
Makefile -linguist-detectable
*.mk -linguist-detectable

# If your build folder or binary objects are accidentally tracked, exclude them too:
build/** linguist-vendored

# Hide CMakeLists.txt and all .cmake files from the language bar
CMakeLists.txt linguist-detectable=false
*.cmake linguist-detectable=false
*.cmake.in linguist-detectable=false

# 1. Force explicit language classification for your files
*.cpp linguist-language=C++
*.cc linguist-language=C++
*.h linguist-language=C++

*.c linguist-language=C

*.go linguist-language=Go

*.sh linguist-language=Shell
*.bash linguist-language=Bash

*.ps1 linguist-language=PowerShell
*.psm1 linguist-language=PowerShell

*.star linguist-language=Starlark
BUCK linguist-language=Starlark
BUILD linguist-language=Starlark

# 2. Ensure GitHub forces these specific file types to be included in the stats
*.cpp linguist-detectable=true
*.c linguist-detectable=true
*.go linguist-detectable=true
*.sh linguist-detectable=true
*.ps1 linguist-detectable=true
*.star linguist-detectable=true
*.bash linguist-detectable=true
BUILD linguist-detectable=true

# 3. Optional: Block unwanted languages or vendor folders from polluting the bar
*.* linguist-detectable=false
*.cpp linguist-detectable=true
*.c linguist-detectable=true
*.go linguist-detectable=true
*.sh linguist-detectable=true
*.ps1 linguist-detectable=true
*.star linguist-detectable=true
*.bash linguist-langauge=true

# Ignore external dependencies or node_modules if they are muddying your chart
node_modules/* linguist-vendored
vendor/* linguist-vendored

